SERVICE_NAME=perception-orchestrator
PERCEPTION_ORCHESTRATOR_IMAGE_TAG=2026.06.04
ENV=dev
LOG_LEVEL=INFO

MQTT_HOST=mosquitto
MQTT_PORT=1883

AUTH_REQUIRED=true

# --- Perception ---
INBOX_ROOT=/data/inbox
ORIGINALS_ROOT=/data/originals/immutable
RESULTS_ROOT=/data/results
QUEUE_DB=/data/state/perception.sqlite

# Bearer-Token zwischen Orchestrator und Nano. Wird zur Inbetriebnahme generiert
# (openssl rand -hex 32) und gleich auf Nano in /etc/perception/env eingetragen.
NANO_BASE_URL=http://192.0.2.10:8800
NANO_TOKEN=__SET_AT_DEPLOY__

DISPATCH_POLL_SECONDS=2.0
